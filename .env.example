# ---------------------------------------------------------------------------
# Seaquel desktop / web-tenant container — env vars
# ---------------------------------------------------------------------------
# Copy to `.env` for local `npm run dev:web:full`. For the published Docker
# image, the canonical example lives at `deploy/docker/.env.example` and is
# kept in sync with this file. Desktop (Tauri) builds ignore everything here
# except `VITE_BUILD_TARGET` and any `VITE_*` keys consumed at build time.
# ---------------------------------------------------------------------------

# ---- Better Auth (web build only) ------------------------------------------
# Session signing key. REQUIRED in production — startup aborts if unset when
# NODE_ENV=production. Generate with: openssl rand -hex 32
SEAQUEL_AUTH_SECRET=REPLACE_WITH_output_of_openssl_rand_hex_32

# Comma-separated list of origins allowed to hit the API (CSRF defense).
# localhost variants are always trusted; only list public origins here.
# Example: SEAQUEL_TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com
# SEAQUEL_TRUSTED_ORIGINS=

# Optional: apex domain for cross-subdomain session cookies.
# Example: SEAQUEL_COOKIE_DOMAIN=.example.com
# SEAQUEL_COOKIE_DOMAIN=

# Optional: canonical URL Better Auth uses for absolute links. Useful when
# the container sits behind a reverse proxy that rewrites Host. Defaults
# to the request-derived origin if unset.
# Example: BETTER_AUTH_URL=https://seaquel.example.com
# BETTER_AUTH_URL=

# ---- Container runtime ------------------------------------------------------
# Where the container persists auth.db + per-user data files. Defaults to
# the process cwd; the Docker image ships with /data.
# DATA_DIR=/data

# Public HTTP port the Node server listens on. Defaults to 8787.
# PORT=8787

# Bind address for the embedded Rust query service (loopback only). Defaults
# to 127.0.0.1:8788 in the Docker image; rarely needs overriding.
# BIND_ADDR=127.0.0.1:8788

# ---- Licensing control plane ------------------------------------------------
# Where this install reports in to verify its license. Defaults to the
# hosted Seaquel control plane; point at your own deployment for staging.
# SEAQUEL_CONTROL_URL=https://seaquel.app

# Seconds between license re-checks against the control plane.
# Default 86400 (24h).
# SEAQUEL_LICENSE_SOFT_TTL=86400

# Offline grace window — how long the install stays usable without a
# successful re-check. Default 1209600 (14d).
# SEAQUEL_LICENSE_GRACE_TTL=1209600

# Hard cap on rows returned by a single query response. Defaults to 100000.
# SEAQUEL_MAX_QUERY_ROWS=100000
