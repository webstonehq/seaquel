# Optional overrides for the Seaquel container. Copy to `.env` next to this
# file ONLY if you need to set one of these — defaults work out of the box
# (port 8787, /data volume, auto-generated session secret at /data/auth-secret,
# licensing via https://seaquel.app). See README.md → "Configuration".

# Public port on the host (default 8787).
# PORT=8787

# REQUIRED only when deploying on a real domain. Comma-separated origins
# Better Auth's CSRF check trusts. Localhost variants are always trusted.
# SEAQUEL_TRUSTED_ORIGINS=https://seaquel.example.com

# Canonical URL Better Auth uses for absolute links. Set when sitting behind
# a reverse proxy that rewrites Host.
# BETTER_AUTH_URL=https://seaquel.example.com

# Multi-replica deployments only. All replicas must share a session-signing
# key, so set this explicitly (e.g. via a secrets manager). Single-container
# installs leave this unset — the secret auto-generates and persists to
# /data/auth-secret.
# SEAQUEL_AUTH_SECRET=

# Multi-subdomain deployments sharing sessions across *.example.com.
# SEAQUEL_COOKIE_DOMAIN=.seaquel.example.com

# Licensing control plane (default https://seaquel.app). Set for staging or
# air-gap testing (use http://127.0.0.1:1 with an imported bundle).
# SEAQUEL_CONTROL_URL=
