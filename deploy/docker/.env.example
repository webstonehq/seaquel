# Optional overrides for the Seaquel container. Copy to `.env` next to this
# file ONLY if you need to set one of these — defaults work out of the box
# (port 8787, /data volume, auto-generated session secret at /data/auth-secret,
# licensing via https://seaquel.app). See README.md → "Configuration".

# Public port on the host (default 8787).
# PORT=8787

# Comma-separated origins the CSRF checks trust, besides BETTER_AUTH_URL's.
# With BETTER_AUTH_URL unset, only an install reached at localhost or an IP
# address trusts its own address; on a domain name, set BETTER_AUTH_URL (or
# list the origin here), or signup, sign-in and /api calls get 403.
# SEAQUEL_TRUSTED_ORIGINS=https://seaquel.example.com

# Canonical URL Better Auth uses for absolute links, and the origin the CSRF
# checks trust. Set it whenever the install is reached by a domain name.
# BETTER_AUTH_URL=https://seaquel.example.com

# Multi-replica deployments only. All replicas must share a session-signing
# key, so set this explicitly (e.g. via a secrets manager). Single-container
# installs leave this unset — the secret auto-generates and persists to
# /data/auth-secret.
# SEAQUEL_AUTH_SECRET=

# Multi-subdomain deployments sharing sessions across *.example.com.
# SEAQUEL_COOKIE_DOMAIN=.seaquel.example.com

# Licensing control plane (default https://seaquel.app). Set for staging or
# air-gap testing (use http://127.0.0.1:1 with an imported bundle).
# SEAQUEL_CONTROL_URL=

# Where the AI assistant's model calls may go (the server calls the
# provider with the key the browser sends per call):
#   public (default) public addresses over https only, no redirects
#   any              private networks and http: too (a local Ollama/vLLM)
#   off              refuse every model call (air-gapped installs)
# Behind HTTPS_PROXY/HTTP_PROXY, `public` still refuses private IP
# literals and names this server resolves only to private addresses; a
# name it can't resolve goes to the proxy, which decides.
# SEAQUEL_AI_EGRESS=public
