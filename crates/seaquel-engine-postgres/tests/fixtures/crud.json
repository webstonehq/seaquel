{
  "cases": [
    {
      "name": "update, single pk, string value, no cast lookup",
      "input": {
        "fn": "update",
        "schema": "public",
        "table": "users",
        "column": "name",
        "value": "Ada",
        "primaryKeys": [
          "id"
        ],
        "row": {
          "id": 1,
          "name": "Grace",
          "email": "g@example.com"
        }
      },
      "output": {
        "sql": "UPDATE \"public\".\"users\" SET \"name\" = $1 WHERE \"id\" = $2",
        "bindValues": [
          "Ada",
          1
        ]
      }
    },
    {
      "name": "update, cast lookup hits the column",
      "input": {
        "fn": "update",
        "schema": "public",
        "table": "products",
        "column": "price",
        "value": "12.50",
        "primaryKeys": [
          "id"
        ],
        "row": {
          "id": 7,
          "price": "10.00"
        },
        "casts": {
          "price": "numeric",
          "id": "integer"
        }
      },
      "output": {
        "sql": "UPDATE \"public\".\"products\" SET \"price\" = CAST($1 AS numeric) WHERE \"id\" = $2",
        "bindValues": [
          "12.50",
          7
        ]
      }
    },
    {
      "name": "update, cast lookup misses the column",
      "input": {
        "fn": "update",
        "schema": "public",
        "table": "products",
        "column": "name",
        "value": "Widget",
        "primaryKeys": [
          "id"
        ],
        "row": {
          "id": 7,
          "name": "Gadget"
        },
        "casts": {
          "price": "numeric"
        }
      },
      "output": {
        "sql": "UPDATE \"public\".\"products\" SET \"name\" = $1 WHERE \"id\" = $2",
        "bindValues": [
          "Widget",
          7
        ]
      }
    },
