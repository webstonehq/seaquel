          "id": 2
        },
        "casts": {
          "col\"umn": "text"
        }
      },
      "output": {
        "sql": "UPDATE \"my\"\"schema\".\"the \"\"table\"\"\" SET \"col\"\"umn\" = CAST($1 AS text) WHERE \"p\"\"k\" = $2 AND \"id\" = $3",
        "bindValues": [
          "x",
          "a",
          2
        ]
      }
    },
