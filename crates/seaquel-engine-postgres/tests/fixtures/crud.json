    {
      "name": "update, object value (json)",
      "input": {
        "fn": "update",
        "schema": "public",
        "table": "all_types",
        "column": "col_jsonb",
        "value": {
          "key": "value",
          "nested": {
            "list": [
              1,
              2,
              3
            ]
          },
          "ok": true
        },
        "primaryKeys": [
          "id"
        ],
        "row": {
          "id": 1,
          "col_jsonb": {
            "key": "old"
          }
        },
        "casts": {
          "col_jsonb": "jsonb"
        }
      },
      "output": {
        "sql": "UPDATE \"public\".\"all_types\" SET \"col_jsonb\" = CAST($1 AS jsonb) WHERE \"id\" = $2",
        "bindValues": [
          {
            "key": "value",
            "nested": {
              "list": [
                1,
                2,
                3
              ]
            },
            "ok": true
          },
          1
        ]
      }
    },
    {
      "name": "update, identifiers containing double quotes",
      "input": {
        "fn": "update",
        "schema": "my\"schema",
