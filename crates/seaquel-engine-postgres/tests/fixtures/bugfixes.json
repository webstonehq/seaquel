      "input": {
        "fn": "update",
        "schema": "public",
        "table": "events",
        "column": "happened_at",
        "value": null,
        "primaryKeys": ["id"],
        "row": { "id": "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11", "happened_at": "2024-01-02 3:04:05.5" },
        "casts": { "id": "uuid", "happened_at": "timestamp without time zone" }
      },
      "output": {
        "sql": "UPDATE \"public\".\"events\" SET \"happened_at\" = CAST($1 AS timestamp without time zone) WHERE \"id\" = CAST($2 AS uuid)",
