{
  "about": "Hand-written expectations for the intended changes from the TypeScript Postgres dialect (see 'Bug fixes' in docs/plans/2026-09-25-rust-core-phase-1-plan.md). The recorder never writes this file. Fix 1: catalog filters are bound, so these tables load. Fix 2: the DDL quote escapes embedded double quotes. Fix 3: DROP INDEX is schema-qualified with the original definition's schema (where the index lives). Fix 4: index columns come from pg_index/pg_get_indexdef (expressions shown, INCLUDE columns left out), unique from indisunique, type from the access method; indexes are listed by name. Fix 5 (statistics by relid) has no case here; smoke.rs checks it live. Fix 6: CRUD casts primary-key placeholders with the cast map in update, setDefault and delete, so uuid/date/timestamp keys sent as text compare; the TypeScript builders never cast keys, so crud.json is replayed without key casts. Fix 7: the columns query adds castType (format_type, with character and bit lengths dropped), and CRUD casts to it verbatim. 'columns' and 'indexes' cases run against the scratch schema built by scratch.setup.",
  "scratch": {
    "schema": "seaquel_fixtures",
    "setup": [
      "CREATE SCHEMA seaquel_fixtures",
      "CREATE TABLE seaquel_fixtures.customers (id integer PRIMARY KEY, name varchar(100) NOT NULL, email text UNIQUE)",
      "INSERT INTO seaquel_fixtures.customers (id, name, email) SELECT n, 'Customer ' || n, 'c' || n || '@example.com' FROM generate_series(1, 50) AS n",
      "CREATE TABLE seaquel_fixtures.region_stock (region text NOT NULL, sku varchar(32) NOT NULL, qty integer NOT NULL DEFAULT 0, user_id integer REFERENCES public.users (id), attrs jsonb, PRIMARY KEY (region, sku))",
      "CREATE INDEX region_stock_lower_sku_idx ON seaquel_fixtures.region_stock (lower(sku))",
      "CREATE INDEX region_stock_qty_incl_idx ON seaquel_fixtures.region_stock (qty) INCLUDE (user_id)",
      "CREATE UNIQUE INDEX region_stock_user_sku_key ON seaquel_fixtures.region_stock (user_id, sku)",
      "CREATE INDEX region_stock_attrs_gin_idx ON seaquel_fixtures.region_stock USING gin (attrs)",
      "CREATE TABLE seaquel_fixtures.events (id integer PRIMARY KEY, customer_id integer NOT NULL REFERENCES seaquel_fixtures.customers (id), kind text NOT NULL, created_at timestamp NOT NULL, payload jsonb)",
      "INSERT INTO seaquel_fixtures.events (id, customer_id, kind, created_at, payload) SELECT n, n % 50 + 1, (ARRAY['click', 'view', 'buy', 'share'])[n % 4 + 1], timestamp '2026-01-01 00:00:00' + n * interval '1 minute', jsonb_build_object('n', n) FROM generate_series(1, 5000) AS n",
      "CREATE INDEX events_kind_idx ON seaquel_fixtures.events (kind)",
      "CREATE VIEW seaquel_fixtures.customer_names AS SELECT id, name FROM seaquel_fixtures.customers",
      "CREATE MATERIALIZED VIEW seaquel_fixtures.customer_counts AS SELECT kind, count(*) AS n FROM seaquel_fixtures.events GROUP BY kind",
      "CREATE TABLE seaquel_fixtures.\"order items\" (id serial PRIMARY KEY, region text NOT NULL, customer_id integer NOT NULL REFERENCES seaquel_fixtures.customers (id), name varchar(200) NOT NULL, sku text NOT NULL, qty integer NOT NULL DEFAULT 1, note text, attrs jsonb)",
      "CREATE INDEX \"order items_lower_name_idx\" ON seaquel_fixtures.\"order items\" (lower(name))",
      "CREATE INDEX order_items_sku_incl_idx ON seaquel_fixtures.\"order items\" (sku) INCLUDE (qty, note)",
      "CREATE UNIQUE INDEX order_items_region_sku_key ON seaquel_fixtures.\"order items\" (region, sku)",
      "CREATE INDEX order_items_attrs_gin_idx ON seaquel_fixtures.\"order items\" USING gin (attrs)",
      "CREATE TABLE seaquel_fixtures.\"my-table\" (id integer PRIMARY KEY, value text DEFAULT 'n/a')"
    ],
    "teardown": ["DROP SCHEMA IF EXISTS seaquel_fixtures CASCADE"]
  },
