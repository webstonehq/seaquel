  {
    "name": "secrets/all-flags-all-secrets",
    "target": "saved",
    "op": "connect",
    "changedBy": [
      "2"
    ],
    "v1Notes": "Key auth with every flag on: the SSH password is read and sent too.",
    "input": {
      "row": {
        "id": "conn-secrets-all-flags-all-secrets",
        "projectId": "default-seaquel",
        "labelIds": [],
        "savePassword": true,
        "saveSshPassword": true,
        "saveSshKeyPassphrase": true,
        "name": "PG",
        "type": "postgres",
        "host": "db.internal",
        "port": 5432,
        "databaseName": "app",
        "username": "alice",
        "connectionString": "postgresql://alice@db.internal:5432/app",
        "sshTunnel": {
          "enabled": true,
          "host": "bastion.example.com",
          "port": 2222,
          "username": "deploy",
          "authMethod": "key",
          "keyPath": "/Users/me/.ssh/id_ed25519"
        }
      },
      "secrets": {
        "db:conn-secrets-all-flags-all-secrets": "pw",
        "ssh:conn-secrets-all-flags-all-secrets": "ssh-pw",
        "ssh-key:conn-secrets-all-flags-all-secrets": "key-pass"
      },
      "supplied": {},
      "createIfMissing": false,
      "tunnelPort": 50010
    },
    "expected": {
      "secretsRead": [
        "db:conn-secrets-all-flags-all-secrets",
        "ssh:conn-secrets-all-flags-all-secrets",
        "ssh-key:conn-secrets-all-flags-all-secrets"
      ],
      "tunnel": {
        "sshHost": "bastion.example.com",
        "sshPort": 2222,
        "sshUsername": "deploy",
        "authMethod": "key",
        "password": "ssh-pw",
        "keyPath": "/Users/me/.ssh/id_ed25519",
        "keyPassphrase": "key-pass",
        "remoteHost": "db.internal",
        "remotePort": 5432
      },
      "config": {
        "driver": "postgres",
        "connection_string": "postgresql://alice:pw@127.0.0.1:50010/app"
      }
    },
    "v1": {
      "file": "connect-config/secrets.json",
      "output": "autoReconnect"
    }
  },
