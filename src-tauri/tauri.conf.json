{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seaquel",
  "version": "2026.9.2",
  "identifier": "app.seaquel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "minWidth": 1112,
        "width": 1112,
        "height": 768,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: http: ws: wss:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./macos/entitlements.plist"
    },
    "windows": {
      "signCommand": "trusted-signing-cli -e https://eus.codesigning.azure.net -a Seaquel -c Seaquel -d Seaquel %1"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "deep-link": {
      "desktop": {
        "schemes": ["seaquel"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyOTVBN0ZENzA5RjJGMjQKUldRa0w1OXcvYWVWc2tWMGhxSG9jMVdIcTFmSm9sVHN0dFRSWXAxdXhWMTZhaFhKbHlMbnRrMzEK",
      "endpoints": [
        "https://seaquel.app/updates/check/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
